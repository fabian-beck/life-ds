  },
  "subtopics": [
    {
      "id": "imagining_the_universal_machine",
      "title": "Imagining the Universal Machine",
      "description": "Before computers existed, computation had to be conceived: as a general method, a programmable idea, and a theory of what machines could (and could not) do.",
      "person_ids": [
        "ada_lovelace",
        "alan_turing",
        "john_von_neumann"
      ]
    },
    {
      "id": "from_blueprints_to_working_machines",
      "title": "From Blueprints to Working Machines",
      "description": "Under pressure—from war, engineering limits, and institutional demand—computing became physical: relays, architectures, and organizations that could sustain complex machines.",
      "person_ids": [
        "konrad_zuse",
        "alan_turing",
        "john_von_neumann",
        "heinz_nixdorf"
      ]
    },
    {
      "id": "the_software_revolution",
      "title": "The Software Revolution",
      "description": "As hardware improved, the decisive frontier became software: languages, compilers, and methods that made programs reliable, fast, and readable—and made teams possible.",
      "person_ids": [
        "grace_hopper",
        "edsger_w_dijkstra",
        "frances_allen"
      ]
    },
    {
      "id": "power_and_its_discontents",
      "title": "Power and Its Discontents",
      "description": "When computers began to mimic human-like interaction and shape society, pioneers debated what should be automated and what must remain human responsibility.",
      "person_ids": [
        "joseph_weizenbaum",
        "steve_jobs"
      ]
    }
  ],
