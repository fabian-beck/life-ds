      "title": "Dreams of Programmability",
      "description": "Before computers were common objects, they were arguments: that a machine could follow symbolic instructions and that “computation” could be defined with precision.",
      "person_ids": [
        "ada_lovelace",
        "alan_turing",
        "john_von_neumann"
      ]
    },
    {
      "id": "machines_that_ran",
      "title": "Machines That Ran",
      "description": "Turning theory into working artifacts required bold engineering—devices that actually executed programs, survived constraints, and proved feasibility in the real world.",
      "person_ids": [
        "konrad_zuse",
        "heinz_nixdorf"
      ]
    },
    {
      "id": "teaching_machines_to_think_in_code",
      "title": "Teaching Machines in Code",
      "description": "Once hardware existed, the bottleneck became human: languages, compilers, and disciplined methods that made software legible, efficient, and trustworthy at scale.",
      "person_ids": [
        "grace_hopper",
        "edsger_w_dijkstra",
        "frances_allen"
      ]
    },
    {
      "id": "computing_meets_society",
      "title": "Computing Meets Society",
      "description": "As computers moved from institutions to everyday life, two complementary roles emerged: the builder of mass adoption and the skeptic who insisted on moral and social limits.",
      "person_ids": [
        "steve_jobs",
        "joseph_weizenbaum"
      ]
    }
  ],
