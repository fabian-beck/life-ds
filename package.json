{
  "name": "life-ds-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:interface": "playwright test",
    "test:interface:report": "playwright show-report",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:py",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:py": "flake8 scripts/",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write \"**/*.{js,svelte,json,css,md}\" --ignore-path .prettierignore && black scripts/",
    "format:check": "prettier --check \"**/*.{js,svelte,json,css,md}\" --ignore-path .prettierignore && black --check scripts/",
    "type-check:py": "mypy scripts/",
    "validate": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.5",
    "svelte-eslint-parser": "^1.8.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@protomaps/basemaps": "^5.7.0",
    "d3-force": "^3.0.0",
    "maplibre-gl": "^5.18.0",
    "pmtiles": "^4.4.0",
    "svelte-spa-router": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "scripts/*.py": [
      "black",
      "flake8"
    ]
  }
}
