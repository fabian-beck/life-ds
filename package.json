{
  "name": "life-ds-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:evaluation": "vite --mode evaluation",
    "build": "vite build",
    "build:evaluation": "vite build --mode evaluation",
    "preview": "vite preview",
    "preview:card": "node scripts/capture_social_preview.mjs",
    "report:pdf": "node scripts/export_report_pdf.mjs",
    "report:shots": "python scripts/generate_report.py --shots",
    "basemap:assets": "node scripts/vendor_basemap_assets.mjs",
    "test:interface": "playwright test",
    "test:core": "npm run test:interface && python -m pytest",
    "test:interface:report": "playwright show-report",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:py",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:py": "flake8 scripts/ evaluation/",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write \"**/*.{js,svelte,json,css,md}\" --ignore-path .prettierignore && black scripts/ evaluation/",
    "format:check": "prettier --check \"**/*.{js,svelte,json,css,md}\" --ignore-path .prettierignore && black --check scripts/ evaluation/",
    "type-check:py": "mypy scripts/ evaluation/",
    "type-check:js": "tsc -p jsconfig.json",
    "validate": "npm run format:check && npm run lint && npm run type-check:js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "lint-staged": "^17.0.8",
    "pbf": "^5.1.2",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.5",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@netlify/blobs": "^11.0.2",
    "@protomaps/basemaps": "^5.7.0",
    "d3-force": "^3.0.0",
    "maplibre-gl": "^5.18.0",
    "pmtiles": "^4.4.0",
    "svelte-spa-router": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "scripts/*.py": [
      "black",
      "flake8"
    ]
  }
}
