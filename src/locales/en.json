  "landing.ai_how_it_works": "How it works:",
  "landing.ai_description": "This application uses AI to automatically generate biographical timelines from Wikipedia content. The process includes:",
  "landing.ai_step_1": "Fetching biographical data and related articles from Wikipedia",
  "landing.ai_step_2": "Using AI to extract life events, dates, locations, and relationships with structured outputs",
  "landing.ai_step_3": "Geocoding location names to coordinates via OpenStreetMap's Nominatim service",
  "landing.ai_step_4": "Discovering and matching relevant images from Wikimedia Commons to events",
  "landing.ai_step_5": "Generating custom visual styles and color schemes for each person",
  "landing.ai_accuracy": "Accuracy:",
  "landing.ai_accuracy_text": "While AI extraction is generally accurate, errors may occur in dates, locations, or interpretations. All content is sourced from Wikipedia and cited accordingly.",
  "landing.ai_report": "In depth:",
  "landing.ai_report_text": "The technical report documents the data model, both generation pipelines with their prompts, schemas and recorded timings, the application, localization and testing.",
  "landing.report_link": "Read the technical report",
  "landing.privacy_label": "Privacy",
  "landing.open_privacy": "Read the privacy notice",
  "landing.privacy_modal_title": "Privacy",
  "landing.privacy_modal_close": "Close modal",
  "landing.privacy_no_tracking": "No tracking:",
  "landing.privacy_no_tracking_text": "This site sets no cookies, runs no analytics, and carries no advertising. Nothing you read or click here is recorded to profile you.",
  "landing.privacy_hosting": "Hosting:",
  "landing.privacy_hosting_text": "The site is served by Netlify. Like any web server, it logs the requesting IP address, the time, and the address requested, which is what delivering pages and defending them against abuse requires.",
  "landing.privacy_third_party": "Content from other sites:",
  "landing.privacy_third_party_text": "Text, portraits, chapter art, fonts, and the map come from this site's own server. The photographs inside the stories do not: each stays with the archive that holds it, so that its source and its license travel with it. Three hosts serve them — upload.wikimedia.org (Wikimedia Commons), live.staticflickr.com (Flickr), and images.memorix.nl (the image bank of the Dutch Cultural Heritage Agency). Your browser contacts them directly as a slide is shown, and each of them sees your IP address, your browser identification, and that the request came from this site. Following a source, license, or reference link leaves this site altogether.",
  "landing.privacy_storage": "In your browser:",
  "landing.privacy_storage_text": "Your language, the high-contrast setting, and your reading position in a collection are kept in the browser's own storage on your device. They are never sent anywhere, and clearing the site data removes them.",
  "landing.privacy_contact": "Contact:",
  "landing.privacy_contact_text": "Fabian Beck, University of Bamberg, is responsible for this site and reachable at",
